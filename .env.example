# HeliosGen is a local-only desktop app. The packaged build sets everything it
# needs at runtime — you only need this file for `pnpm dev` in a browser, and
# even then every value is optional (API keys are normally saved in-app via
# Settings → API Keys and stored in the local SQLite DB).

# Optional fallback kie.ai key (Settings → API Keys is the normal path).
KIE_API_KEY=

# Optional Azure OpenAI key, only if routing GPT Image 2 through Azure AI Foundry.
AZURE_API_KEY=

# Optional Venice AI key, for the hosted uncensored image models (Krea 2 Turbo,
# Lustify, Chroma, WAI Illustrious, Qwen Image 3). Get one at
# https://venice.ai/settings/api — Venice hosts a fixed catalogue, so no custom
# checkpoints or LoRA files.
VENICE_API_KEY=

# Optional CivitAI API token, for running community checkpoints (e.g. FinePorn v6
# Turbo) on Civitai's own workers via the Orchestration API. Get one at
# https://civitai.com/user/account — paid in Buzz, NSFW needs yellow Buzz.
CIVITAI_API_KEY=

# Verbose client logging.
NEXT_PUBLIC_DEBUG=
